{
  "description": "pythia: the harness hooks. SessionStart prints the Learn-Ask-Do guide and the project's live state. PreToolUse (Bash, SQLcl run-sql) lets read-only pythia commands and already-approved writes through, and denies writes that skip the gate. PostToolUse on AskUserQuestion mints the one-time grant when the developer answers Approve to a question carrying `pythia approve --card <token>` verbatim; PostToolUse on Bash reminds the agent of the exit-code verdicts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/pythia.py\" hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/pythia.py\" hook pre-tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__run-sql.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/pythia.py\" hook pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/pythia.py\" approve --hook",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/pythia.py\" hook post-tool",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
